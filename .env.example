# Copy to .env and fill in. Never commit .env.
# Secrets (required for production):
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
INTERNAL_API_TOKEN=

# Non-secret; docker-compose.yml sets these for the containers:
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=
POSTGRES_HOST=
POSTGRES_PORT=
FRONTEND_INTERNAL_URL=
API_INTERNAL_URL=
BACKEND_URL=
SITE_URL=
USD_RATE=

# Optional: link to your 2GIS reviews page (shown on /reviews when set)
REVIEWS_2GIS_URL=
# Cities with on-site visits, comma separated, Russian names (default: Алматы)
ONSITE_CITIES=
WORKING_HOURS=
